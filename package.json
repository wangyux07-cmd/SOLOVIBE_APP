{
  "name": "solovibe-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "SoloVibe city outing planner",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "start": "npm run preview --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "backend": "powershell -NoProfile -File ./scripts/dev.ps1 -Service backend",
    "install:frontend": "npm ci",
    "install:backend": "powershell -NoProfile -File ./scripts/setup.ps1 -SkipFrontend",
    "install:all": "npm run install:frontend && npm run install:backend"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "frontend"
  ],
  "keywords": ["langgraph", "fastapi", "react", "city-itinerary"],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
