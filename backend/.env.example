# Copy to backend/.env. Never commit credentials.
# Stages 1-2 use DeepSeek and PostgreSQL. Use a direct or SESSION pooler connection.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional Stage 2 application input cap. Provider context_window is read from /models.
SOLOVIBE_UNDERSTAND_INPUT_TOKENS=8000
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
TAVILY_API_KEY=
SERPER_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
