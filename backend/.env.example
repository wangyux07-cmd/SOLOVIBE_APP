# Copy to backend/.env. Never commit credentials.
# Stages 1-3 use DeepSeek and PostgreSQL. Use a direct or SESSION pooler connection.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional Stage 2 application input cap. Provider context_window is read from /models.
SOLOVIBE_UNDERSTAND_INPUT_TOKENS=8000
# Stage 3: Amap Web Service key. Required for real place and walking-route options.
AMAP_API_KEY=
# Stage 3: optional web search. Search links are unverified venue evidence.
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# V3-4 optional, disabled until a real merchant grants read/display rights.
# Never enter a consumer account cookie or a Meituan/Dianping key without the applicable scope.
# The endpoint is a merchant-owned HTTPS bridge implementing the documented JSON contract.
MERCHANT_LIVE_ENDPOINT=
MERCHANT_LIVE_TOKEN=
MERCHANT_LIVE_AMAP_POI_ID=
MERCHANT_LIVE_BRANCH_ID=
MERCHANT_LIVE_AUTHORIZATION_REF=
MERCHANT_LIVE_GRANT_EXPIRES_AT=
MERCHANT_LIVE_SOURCE_URL=
MERCHANT_LIVE_FIELDS=open_now,availability
